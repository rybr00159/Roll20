      "metadata": {
        "role": "Ambush archer and camouflaged scout",
        "progression": "MPMM bugbear +2 Dex/+1 Con; Ranger 4 Piercer +1 Dex. No racial feat; house Sharpshooter has no ASI.",
        "grim_hollow": {
          "kind": "item",
          "name": "Carvaloth Scale Armor"
        },
        "capacity_multiplier": 2,
        "import_notes": "Enter 420 gp. Set initiative modifier +2 beyond Dexterity, giving +6 total for Dread Ambusher. Canny expertise and Iron Mind saves are included. Carvaloth sight-hiding rolls are normally straight after cancelling its normal armor disadvantage. Add +10 for Pass without Trace only while active. Track first-turn bonuses individually.",
        "tactics": [
          "Act before your target to add bugbear damage to each hit; take three shots on the first Attack action and add the Dread Ambusher d8 only to its extra shot. Use Sharpshooter selectively.",
          "Use darkness against darkvision-dependent enemies and camouflage against sight-based detection. Neither grants automatic surprise or hiding.",
          "Use Pass without Trace to help the group approach, or Spike Growth for terrain control. These conflict with Favored Foe and Zephyr Strike concentration."
        ],
        "assumptions": [],
        "spell_groups": {
          "Five normal Ranger spells known": [
